<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.admin.mapper.ChatSessionMapper">

    <resultMap id="ChatSessionResultMap" type="com.example.admin.entity.ChatSession">
        <id column="id" property="id"/>
        <result column="session_type" property="sessionType"/>
        <result column="post_id" property="postId"/>
        <result column="order_id" property="orderId"/>
        <result column="last_message_id" property="lastMessageId"/>
        <result column="last_message_time" property="lastMessageTime"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectById" resultMap="ChatSessionResultMap">
        SELECT id, session_type, post_id, order_id, last_message_id, last_message_time, status, create_time, update_time
        FROM chat_session
        WHERE id = #{id}
    </select>

    <update id="updateChatSession" parameterType="com.example.admin.entity.ChatSession">
        UPDATE chat_session
        SET session_type = #{sessionType},
            post_id = #{postId},
            order_id = #{orderId},
            last_message_id = #{lastMessageId},
            last_message_time = #{lastMessageTime},
            status = #{status},
            update_time = NOW()
        WHERE id = #{id}
    </update>

</mapper>

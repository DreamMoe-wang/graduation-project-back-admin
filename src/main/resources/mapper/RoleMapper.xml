<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.admin.mapper.RoleMapper">

    <resultMap id="RoleResultMap" type="com.example.admin.entity.Role">
        <id column="id" property="id"/>
        <result column="role_name" property="roleName"/>
        <result column="role_code" property="roleCode"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="BaseColumns">
        id, role_name, role_code, status, remark, create_time, update_time
    </sql>

    <select id="selectById" resultMap="RoleResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_role
        WHERE id = #{id}
    </select>

    <select id="selectByRoleCode" resultMap="RoleResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_role
        WHERE role_code = #{roleCode}
        LIMIT 1
    </select>

    <select id="selectByIds" resultMap="RoleResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_role
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="selectPage" resultMap="RoleResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM sys_role
        ORDER BY id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countPage" resultType="long">
        SELECT COUNT(1)
        FROM sys_role
    </select>

    <select id="countByRoleCode" resultType="long">
        SELECT COUNT(1)
        FROM sys_role
        WHERE role_code = #{roleCode}
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>

    <insert id="insertRole" parameterType="com.example.admin.entity.Role" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_role
        (role_name, role_code, status, remark, create_time, update_time)
        VALUES
        (#{roleName}, #{roleCode}, #{status}, #{remark}, NOW(), NOW())
    </insert>

    <update id="updateRole" parameterType="com.example.admin.entity.Role">
        UPDATE sys_role
        SET role_name = #{roleName},
            role_code = #{roleCode},
            status = #{status},
            remark = #{remark},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_role
        WHERE id = #{id}
    </delete>

</mapper>

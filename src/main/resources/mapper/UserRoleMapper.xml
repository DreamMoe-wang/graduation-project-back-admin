<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.admin.mapper.UserRoleMapper">

    <resultMap id="UserRoleResultMap" type="com.example.admin.entity.UserRole">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="role_id" property="roleId"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectByUserId" resultMap="UserRoleResultMap">
        SELECT id, user_id, role_id, create_time
        FROM sys_user_role
        WHERE user_id = #{userId}
        ORDER BY id ASC
    </select>

    <select id="countByRoleId" resultType="long">
        SELECT COUNT(1)
        FROM sys_user_role
        WHERE role_id = #{roleId}
    </select>

    <select id="countByUserIdAndRoleId" resultType="long">
        SELECT COUNT(1)
        FROM sys_user_role
        WHERE user_id = #{userId}
          AND role_id = #{roleId}
    </select>

    <insert id="insertUserRole" parameterType="com.example.admin.entity.UserRole" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user_role
        (user_id, role_id, create_time)
        VALUES
        (#{userId}, #{roleId}, NOW())
    </insert>

    <delete id="deleteByUserId">
        DELETE FROM sys_user_role
        WHERE user_id = #{userId}
    </delete>

</mapper>

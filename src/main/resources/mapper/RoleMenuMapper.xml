<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.admin.mapper.RoleMenuMapper">

    <resultMap id="RoleMenuResultMap" type="com.example.admin.entity.RoleMenu">
        <id column="id" property="id"/>
        <result column="role_id" property="roleId"/>
        <result column="menu_id" property="menuId"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectByRoleIds" resultMap="RoleMenuResultMap">
        SELECT id, role_id, menu_id, create_time
        FROM sys_role_menu
        WHERE role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
    </select>

    <select id="countByMenuId" resultType="long">
        SELECT COUNT(1)
        FROM sys_role_menu
        WHERE menu_id = #{menuId}
    </select>

    <select id="countByRoleIdAndMenuId" resultType="long">
        SELECT COUNT(1)
        FROM sys_role_menu
        WHERE role_id = #{roleId}
          AND menu_id = #{menuId}
    </select>

    <insert id="insertRoleMenu" parameterType="com.example.admin.entity.RoleMenu" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_role_menu
        (role_id, menu_id, create_time)
        VALUES
        (#{roleId}, #{menuId}, NOW())
    </insert>

    <delete id="deleteByMenuId">
        DELETE FROM sys_role_menu
        WHERE menu_id = #{menuId}
    </delete>

</mapper>
